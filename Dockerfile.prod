# Боевой образ: код внутри, ничего не монтируется, процесс не от root.
# Отличия от Dockerfile.dev: собирается в два этапа (компилятор не едет в
# готовый образ) и содержит все четыре сервиса — приём, качество, разбор и
# воркер, — потому что монтировать их с хоста здесь нечем.
FROM python:3.11-slim AS builder

ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Только то, что нужно на исполнении: распознавание, рендер PDF и
# конвертер .doc (см. Dockerfile.dev — там же причина).
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tesseract-ocr \
    tesseract-ocr-rus \
    poppler-utils \
    libreoffice-writer \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Модели tessdata_best рядом с системными. В пакетах Debian лежит
# tessdata_fast — самый маленький и самый неточный из трёх опубликованных
# вариантов; отдельного пакета с best в Debian нет, поэтому файлы берутся
# из официального хранилища tesseract-ocr (лицензия Apache-2.0, файл
# LICENSE в том же хранилище) и проверяются по контрольной сумме: модель —
# это данные, которыми читаются документы заказчика, и подменять их молча
# нельзя. Выбор модели — настройка `OCR_TESSDATA_DIR`, по умолчанию пусто,
# то есть читают системные модели и образ ведёт себя как прежде.
#
# osd кладётся в каталог копией системного. Распознаванию он не нужен —
# `--tessdata-dir` получают только вызовы с языками rus+eng, — но тот же
# каталог можно включить переменной TESSDATA_PREFIX, а она подменяет
# каталог всем вызовам Tesseract, в том числе определению поворота листа.
# В tessdata_best это побайтово тот же файл, поэтому он копируется из
# образа, а не скачивается.
#
# TESSDATA_BEST_ENABLED=0 собирает образ без скачивания: сборке в сети без
# выхода на github остаются системные модели и прежнее поведение.
ARG TESSDATA_BEST_ENABLED=1
ARG TESSDATA_BEST_URL=https://github.com/tesseract-ocr/tessdata_best/raw/4.1.0
ARG TESSDATA_BEST_RUS_SHA256=b617eb6830ffabaaa795dd87ea7fd251adfe9cf0efe05eb9a2e8128b7728d6b6
ARG TESSDATA_BEST_ENG_SHA256=8280aed0782fe27257a68ea10fe7ef324ca0f8d85bd2fd145d1c2b560bcb66ba
RUN if [ "$TESSDATA_BEST_ENABLED" = "1" ]; then set -e; \
      mkdir -p /opt/tessdata/best; \
      curl -sSLf -o /opt/tessdata/best/rus.traineddata "$TESSDATA_BEST_URL/rus.traineddata"; \
      curl -sSLf -o /opt/tessdata/best/eng.traineddata "$TESSDATA_BEST_URL/eng.traineddata"; \
      echo "$TESSDATA_BEST_RUS_SHA256  /opt/tessdata/best/rus.traineddata" | sha256sum -c -; \
      echo "$TESSDATA_BEST_ENG_SHA256  /opt/tessdata/best/eng.traineddata" | sha256sum -c -; \
      cp "$(dirname "$(find /usr/share -name osd.traineddata -print -quit)")/osd.traineddata" \
         /opt/tessdata/best/; \
    fi

COPY --from=builder /install /usr/local

COPY core/ ./core/
COPY ingest/ ./ingest/
COPY gateway/ ./gateway/
COPY quality/ ./quality/
COPY alembic/ ./alembic/
COPY config/ ./config/
COPY alembic.ini init_db.py ./

RUN useradd --create-home --uid 1000 app \
    && mkdir -p /data/shared \
    && chown -R app:app /app /data/shared
USER app

CMD ["uvicorn", "ingest.api:app", "--host", "0.0.0.0", "--port", "8000"]
