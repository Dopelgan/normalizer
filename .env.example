# ============================================
# ОБЩИЕ НАСТРОЙКИ
# ============================================
TZ=UTC
LOG_LEVEL=INFO
API_PORT=8000
# Формат логов: json — строка на событие, разбирается любым сборщиком
# логов; text — как было, для чтения глазами во время разработки.
# Замеры времени идут событиями "event":"stage" с полем duration_ms.
LOG_FORMAT=json
# Логи доступа uvicorn на каждый опрос /health и /metrics забивают ленту.
QUIET_ACCESS_LOG=true
# Порт метрик Prometheus у воркеров (у сервисов метрики отдаёт /metrics).
# В compose проброшены: разбор — 9100, приём — 9101.
METRICS_WORKER_PORT=9100

# ============================================
# БАЗА ДАННЫХ (PostgreSQL)
# ============================================
# ВНИМАНИЕ: пароли ниже — значения для локальной разработки.
# Перед любым развёртыванием за пределами ноутбука их надо заменить.
POSTGRES_USER=knowledge_user
POSTGRES_PASSWORD=secure_password_please_change
POSTGRES_DB=knowledge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://knowledge_user:secure_password_please_change@postgres:5432/knowledge

# ============================================
# БРОКЕР (Redis)
# ============================================
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
EVENT_BROKER_URL=redis://redis:6379/1

# ============================================
# ХРАНИЛИЩЕ ФАЙЛОВ
# ============================================
STORAGE_TYPE=local                     # local | s3
STORAGE_LOCAL_MOUNT=/data/shared
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=test-bucket

# Где Parser ищет входные файлы по s3_fileid из запроса RAG.
SOURCE_PREFIX=documents/
# Бакет вложений чата Backend. Пусто — выключено. На проде: chat-attachments.
# Проверяется, только если s3_fileid — голый uuid в нижнем регистре и в
# S3_BUCKET по нему ничего не нашлось.
S3_ATTACHMENTS_BUCKET=
# Куда складываются изображения, извлечённые из PDF.
ASSETS_PREFIX=assets/
# Куда пишется сырой ответ парсера.
RAW_PARSE_S3_PREFIX=raw_parse/

# S3 выдан только на чтение: производное (ассеты, выправленные растры,
# сырой JSON) пишется в ARTIFACTS_MOUNT — том сервиса, а не в бакет.
# false ставится только если бакет действительно доступен на запись.
S3_READONLY=true
ARTIFACTS_MOUNT=/data/shared
# Временные файлы процессов и их подпроцессов (poppler, tesseract).
TEMP_DIR=/data/shared/tmp

# ============================================
# MINERU
# ============================================
MINERU_VERSION=3.4.5
MINERU_PORT=8000
MINERU_ENDPOINT=http://mineru-api:8000
MINERU_TIMEOUT=300
MINERU_MODEL_CACHE=/models/pdf-extract-kit
MINERU_BACKEND=pipeline
MINERU_DEFAULT_LANG=east_slavic
# MINERU_VIRTUAL_VRAM_SIZE здесь намеренно нет: сервис mineru-api берёт только
# якорь defaults, без env_file, и .env не читает. Предел памяти GPU для MinerU
# (8) задан в Dockerfile.mineru — см. README, «Предел памяти GPU для MinerU».

# ============================================
# ЧЕРТЕЖИ: ВНЕШНЯЯ МОДЕЛЬ QWEN3-VL
# ============================================
# Хост с моделью (vLLM, OpenAI-совместимый /v1). Адрес можно писать с /v1 и
# без него. Значения ниже — штатная поставка: контейнер vllm на внутренней
# сети compose. Отдельный хост с GPU пишется сюда же полным адресом.
# Пусто — чертежи не разбираются вовсе: подменять разбор сплошным
# распознаванием листа больше нечем, и молчать об этом система не будет.
QWEN_ENDPOINT=http://vllm:8001/v1
QWEN_MODEL=Qwen/Qwen3.8-27B-FP8
# Ключ vLLM (--api-key). Пусто, если сервер поднят без него.
QWEN_API_KEY=local
QWEN_TIMEOUT=180
QWEN_RETRIES=2
QWEN_MAX_TOKENS=4096
QWEN_TEMPERATURE=0.0
# Длинная сторона листа и вырезанной области при отправке модели.
QWEN_SHEET_MAX_SIDE=2000
QWEN_REGION_MAX_SIDE=1600
QWEN_REGION_UPSCALE=2.0

# Разметка листа зрением перед чтением: выравнивание, рамка формата, сетки
# таблиц. Выключение оставляет только чтение листа целиком — на сборочных
# чертежах это стоит потерянной спецификации.
DRAWING_VISION_ENABLED=true
DRAWING_DESKEW_LIMIT=3.0
DRAWING_MAX_REGIONS=4
# Потолок времени на один лист: запросов к модели несколько, и при неудачном
# сочетании таймаутов они переживают CELERY_TASK_TIME_LIMIT — тогда теряется
# весь результат, а не часть. Держите бюджет заметно ниже предела задачи.
DRAWING_TIME_BUDGET=420

# ============================================
# БИЗНЕС-ЛОГИКА ОБРАБОТКИ
# ============================================
# Только legacy-стратегии локальных инструментов. Parser передаёт блоки
# целиком; рабочую нарезку 512/768 токенов с overlap 15% выполняет RAG.
DEFAULT_CHUNK_SIZE=500
DEFAULT_OVERLAP=50
MIN_CHUNK_SIZE=30
SPREADSHEET_MAX_CELLS=5000000
COMPLETENESS_THRESHOLD=0.5
CONFIDENCE_THRESHOLD=0.6
PROCESSING_TIMEOUT_SECONDS=900
DEFAULT_LANGUAGE=ru

# ============================================
# CELERY
# ============================================
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_ML_QUEUE=ml_gpu
CELERY_TASK_MAX_RETRIES=3

# Очередь синхронного разбора (POST /internal/v1/parse — вложения чата).
# Пусто — синхронный разбор идёт в CELERY_ML_QUEUE вместе с пакетами.
# Здесь не включать: значение задаёт docker-compose.interactive.yml вместе
# с воркером interactive_worker. Без воркера синхронный разбор встанет.
CELERY_INTERACTIVE_QUEUE=

# Очередь приёма — отдельная от разбора. Приём лёгкий (чтение, открытие
# формата, быстрый OCR двух страниц) и идёт в несколько потоков; разбор
# занимает GPU и идёт по одному документу. В общей очереди пачка сканов
# ждала бы чертёж, который модель читает минутами.
CELERY_INTAKE_QUEUE=intake
INTAKE_WORKER_CONCURRENCY=4
INTAKE_TASK_TIME_LIMIT=900
INTAKE_TASK_SOFT_TIME_LIMIT=840

# ============================================
# РЕЗУЛЬТАТ ЗАПРОСА
# ============================================
# По контракту RAG забирает результат сам:
#   GET /internal/v1/parse/results/{request_id}
# Сколько держать готовый результат (секунды):
RESULT_TTL_SECONDS=86400

# Опциональный push поверх поллинга: none | redis_streams | callback | nats
RESULT_DELIVERY_TYPE=none
RESULT_CALLBACK_URL=
RESULT_STREAM_NAME=normalization_results
NATS_SERVERS=
NATS_SUBJECT=normalization.result

# ============================================
# ПРОЧЕЕ
# ============================================
HF_TOKEN=

# ============================================
# ПРИЁМ ДОКУМЕНТОВ: DATA GATEWAY И QUALITY GATE
# ============================================
# Цепочка: gateway -> quality gate -> нормализатор. Только утверждённый
# файл доходит до разбора.
GATEWAY_PORT=8010
QUALITY_GATE_PORT=8011
# Цепочка приёма этим адресом больше не пользуется: оба этапа идут в одной
# задаче. Оставлен для прямого вызова контейнера Quality Gate.
QUALITY_GATE_ENDPOINT=http://quality_gate:8000
PARSER_ENDPOINT=http://ingest_api:8000
# Таймаут на запрос к нормализатору при передаче принятых файлов.
# Между Data Gateway и Quality Gate запроса больше нет: оба этапа идут в
# одной задаче, и таймауту там взяться неоткуда.
INTAKE_TIMEOUT=120
# Потолок числа файлов в одном запросе приёма.
INTAKE_MAX_FILES=500
# Сколько хранится результат приёма для GET /internal/v1/intake/results/{id}.
INTAKE_STATE_TTL_SECONDS=86400
# Передавать ли принятые файлы дальше, в нормализатор. Раньше это был
# закомментированный вызов в коде quality/api.py.
INTAKE_FORWARD_TO_PARSER=false

# Конвертация старых офисных форматов. .doc (Word 97-2003) разбирается
# только через конвертацию в .docx: плоский текст из двоичного формата
# теряет таблицы. Конвертер — LibreOffice, он стоит в образе.
DOC_CONVERT_ENABLED=true
SOFFICE_BIN=soffice
DOC_CONVERT_TIMEOUT=180

# Профиль отсева: какие данные эта установка считает знанием. Файла по
# этому пути в поставке нет — тогда читается образец рядом
# (config/profile.example.yaml). Скопируйте его в profile.yaml, чтобы
# править правила своей установки, не трогая поставляемый файл.
GATEWAY_PROFILE_PATH=config/profile.yaml

# Классификатор приёма (слои G-2, G-3, G-4). Пусто — решают правила,
# конвейер работает и без ML-сервиса, просто с меньшей точностью отсева.
CLASSIFIER_ENDPOINT=
CLASSIFIER_TIMEOUT=30
# Скан PDF без текстового слоя классифицируется по тексту быстрого OCR первых
# страниц (0 — выключено, решают путь и имя). Разрешение — OCR_DPI; в задаче
# приёма те же страницы потом не распознаются второй раз на Quality Gate.
# После бюджета секунд следующая страница не начинается.
GATEWAY_OCR_PROBE_PAGES=2
GATEWAY_OCR_PROBE_SECONDS=60

# Проверка технической пригодности.
QG_SIMILARITY_THRESHOLD=0.85
QG_MAX_AGE_DAYS=1825
QG_OCR_WARN_CONFIDENCE=0.65
QG_OCR_BLOCK_CONFIDENCE=0.35
QG_OCR_PAGES=2
# Доля распознанного текста ниже порога, после которой лист считается
# прочитанным лишь частично и уходит человеку. Среднее по листу вытягивается
# крупной шапкой: заголовок читается, тело нет, а вердикт был «принято».
QG_OCR_UNREADABLE_SHARE=0.6

# Полный OCR документа (фоллбэк, когда MinerU недоступен или скан без слоя).
# Потолок страниц защищает воркер: без него весь PDF рендерился в память
# разом. Усечение не молчит — попадает в degraded разбора.
OCR_FULL_MAX_PAGES=50
# Размер пачки рендера: страницы готовятся порциями, а не все сразу.
OCR_BATCH_PAGES=5
OCR_DPI=200
# Потолок длинной стороны страницы перед распознаванием. Скан A3 приходит
# листом в 6600 px: OCR на нём идёт минутами, а строки читаются не лучше.
OCR_MAX_SIDE=3500
# Нижняя граница длинной стороны. Tesseract работает по высоте строки: на
# мелком растре (вырезка, превью, скан 80x50) она ниже порога распознавания,
# и лист не давал ни одного слова — то есть уходил в карантин как нечитаемый.
OCR_MIN_SIDE=900
# Сколько страниц полного OCR и слоя распознавания читается одновременно
# (по процессу tesseract на страницу). 1 — постранично.
TESSERACT_PAGE_WORKERS=1

# Флаги разбора, по умолчанию выключены (что делают и значения на проде —
# README, «Флаги разбора»).
# Слой распознавания растра: строки ниже порога уверенности отбрасываются
# на страницах, где у MinerU свой текст.
OCR_LAYER_DROP_LOW_CONFIDENCE=false
OCR_LAYER_MIN_LINE_CONFIDENCE=0.4
# Повтор текста MinerU и графика без русских слов из слоя распознавания (растр).
OCR_LAYER_DROP_REPEATED=false
OCR_LAYER_REPEAT_SHARE=0.6
# Неразобранная таблица скана (альбомная на книжном листе) перечитывается
# Qwen-VL по вырезке, поставленной прямо по OSD; не вышло — разбор на текст.
TABLE_VLM_RETRY_ENABLED=false
TABLE_VLM_MAX_TABLES=8
TABLE_VLM_DPI=200
# Лист векторного PDF с прозой в рамке ЕСКД — страница текста, а не чертёж.
DRAWING_TEXT_IN_FRAME_ENABLED=false
# «Таблица» MinerU на половину листа и больше с прозой внутри — рамка
# формата, а не таблица.
FRAME_TABLE_GUARD_ENABLED=false
# Классификатор «чертёж или текст в рамке ЕСКД» (поверх предыдущего флага):
# лист ТЗ/ПМ/ТУ с рисунком — текст; логотип и печать в тексте — не чертёж.
DRAWING_PAGE_CLASSIFIER_ENABLED=false
# Чертёж без измеренной полноты остаётся на проверке пофрагментно, а документ
# partial только при реальной потере (непрочитанные области, лист не
# распознан или пропущен по сроку).
DRAWING_UNMEASURED_NOT_PARTIAL=false
# Лист-картинка (JPG/PNG/TIFF) читается Qwen-VL целиком со штампом и
# проходом «весь текст листа», даже если MinerU нарезал из него виды или
# лестница назвала лист текстом при рамке чертежа. Вместе с предыдущим
# флагом непрочитанные области переписанного листа потерей не считаются.
DRAWING_IMAGE_FULL_READ=false
DRAWING_TRANSCRIBE_MAX_SIDE=2800
DRAWING_TRANSCRIBE_MAX_TOKENS=8192
# Плотный лист (электросхема, табличка), текст которого не помещается в
# потолок ответа: строки оборванного ответа сохраняются, лист дочитывается
# частями GRID x GRID с перекрытием (оборванная часть делится до DEPTH),
# строки сливаются без повторов. Недочитанная часть — потеря, документ partial.
DRAWING_TRANSCRIBE_TILES=false
DRAWING_TRANSCRIBE_TILE_GRID=2
DRAWING_TRANSCRIBE_TILE_OVERLAP=0.06
DRAWING_TRANSCRIBE_TILE_DEPTH=2
DRAWING_TRANSCRIBE_TILE_PARALLEL=4
# Скан чертежа в PDF: лист без фрагмента drawing (повёрнутый лист, который
# MinerU принял за таблицу) читается Qwen-VL целиком, даже если на других
# листах фрагменты drawing уже есть.
DRAWING_SHEET_MISSING_PAGES=false
# Растровый детектор ищет рамку ещё раз по маске, где тонкие линии большого
# листа (от ~3000 px) не пропадают при уменьшении.
RASTER_FRAME_THIN_LINES=false
# Поле «материал» не получает допуск («12Х18Н10Т» давала допуск «H10»).
DRAWING_MATERIAL_NO_TOLERANCE=false
# Скан чертежа в PDF: каждый чертёжный лист читается Qwen-VL целиком со всем
# текстом листа, даже если MinerU нарезал из него виды.
DRAWING_PDF_FULL_READ=false
# Абзац распознавания на листе, переписанном моделью, заменяется её строками
# (только при полном совпадении по длине и цифрам).
DRAWING_TRANSCRIPT_FIXES_OCR=false
# На листе, переписанном моделью, запись распознавания (таблица MinerU, абзац
# Tesseract) убирается как повтор или как шум; при расхождении в цифрах
# («7:1» против «1:1») остаются оба чтения, а чтение модели кладётся рядом.
DRAWING_SUPPRESS_STALE_ON_FULL_READ=false
# Мелкий шрифт: небольшая вырезка увеличивается вдвое перед чтением моделью,
# в запросы добавлено правило про запятую в дробях и предельные отклонения.
DRAWING_SMALL_PRINT_CARE=false
# Отдельный проход по основной надписи: вырезка штампа идёт в модель в своём
# разрешении, графы приходят с подписями по ГОСТ 2.104 (включая подписи, даты,
# «Инв. № подл.», «Перв. примен.» и графу изменений), рукописное помечается.
DRAWING_TITLE_BLOCK_PASS=false
QWEN_TITLE_BLOCK_MAX_SIDE=2600
QWEN_TITLE_BLOCK_UPSCALE=3.0
# Колонка дополнительных граф у левого поля подшивки читается отдельным
# запросом. Действует только с DRAWING_TITLE_BLOCK_PASS=true.
DRAWING_SIDE_COLUMN_READ=true
# Достоверность чисел и знаков размеров: запятая десятичной дроби, «±» и «−»,
# Ra по ГОСТ 2789, масштаб по ГОСТ 2.302, обозначение шва по ГОСТ 14771,
# марка стали не даёт допуска; правка идёт и по ячейкам таблиц MinerU.
DRAWING_DIMENSION_FIDELITY=false
# Файл больше этого размера уходит в карантин, не читаясь в память.
QG_MAX_SIZE_BYTES=209715200

# ============================================
# ЛЕСТНИЦА СТРАТЕГИЙ
# ============================================
# 1 исходник САПР, 2 текстовый слой, 3 табличный разбор,
# 4 распознавание без структуры, 5 детекция областей,
# 6 восстановление растра плюс 5, 7 мультимодальная модель
LADDER_ENABLED_LEVELS=[1,2,3,4,5,6,7]
LADDER_SCORE_THRESHOLD=0.75
# Лист-картинка, который растровый детектор считает чертежом, отдаётся
# чертёжной ветке, даже если MinerU вернул его одной картинкой без текста;
# распознавание ждёт в запасе и возвращается, если модель лист не прочитала
# или прочитала беднее (документ тогда partial, на проверке). Действует
# только вместе с DRAWING_IMAGE_FULL_READ=true.
LADDER_DRAWING_OVER_OCR=false
# Доля символов распознавания, ниже которой разбор листа считается бедным и
# текст распознавания возвращается в документ.
LADDER_CONTENT_KEEP_RATIO=0.5

# Уровень 7. Пусто — уровень неприменим, лестница заканчивается раньше.
VLM_ENDPOINT=
VLM_TIMEOUT=180
VLM_PROMPT=Извлеки весь текст документа, сохраняя структуру.

# Потолок распаковки растра (пикселей). Лист A0 при 600 dpi — ~280 Мпикс.
MAX_IMAGE_PIXELS=300000000
