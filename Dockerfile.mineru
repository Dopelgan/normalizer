FROM vllm/vllm-openai:v0.21.0-cu129

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        fonts-noto-core \
        fonts-noto-cjk \
        fontconfig \
        libgl1 \
        libglib2.0-0 \
        curl && \
    fc-cache -fv && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install -U \
    'mineru[core]==3.4.5' \
    --break-system-packages && \
    python3 -m pip cache purge

ENV MINERU_MODEL_SOURCE=local

# Предел памяти GPU, из которого MinerU выбирает размеры партий и решает,
# чистить ли память между шагами. Своё значение он берёт из `get_vram()`,
# а тот отдаёт ПОЛНЫЙ объём карты: на 48 ГБ выходит batch_ratio 16, а
# очистка между шагами (`clean_vram`, порог ≤ 8 ГБ) не включается никогда.
# Значение стоит в образе, а не в `.env`: сервис `mineru-api` в
# `docker-compose.yml` берёт только якорь `defaults`, без `app-env` с
# `env_file`, то есть `.env` не читает вовсе. В образе оно не теряется при
# пересоздании контейнера, в отличие от override-файла, который нужно
# помнить и передавать через `-f`.
ENV MINERU_VIRTUAL_VRAM_SIZE=8

ENTRYPOINT ["/bin/bash", "-c", "exec \"$@\"", "--"]