FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Системные зависимости: OCR-фоллбэк (tesseract), рендер PDF (poppler) и
# конвертер старых офисных форматов.
#
# libreoffice-writer нужен ради .doc: двоичный Word 97-2003 разбирается
# только через конвертацию в .docx, а плоский текст из него теряет
# таблицы — то есть само содержание документа. Ставится без рекомендуемых
# пакетов: в образ не едут ни Java, ни остальные модули LibreOffice.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    tesseract-ocr \
    tesseract-ocr-rus \
    poppler-utils \
    libreoffice-writer \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Модели tessdata_best рядом с системными — причина и источник те же, что
# в Dockerfile.prod: в пакетах Debian лежит tessdata_fast, самый неточный
# из трёх опубликованных вариантов, отдельного пакета с best нет.
# Выбор модели — настройка `OCR_TESSDATA_DIR`, по умолчанию пусто.
# TESSDATA_BEST_ENABLED=0 собирает образ без скачивания.
ARG TESSDATA_BEST_ENABLED=1
ARG TESSDATA_BEST_URL=https://github.com/tesseract-ocr/tessdata_best/raw/4.1.0
ARG TESSDATA_BEST_RUS_SHA256=b617eb6830ffabaaa795dd87ea7fd251adfe9cf0efe05eb9a2e8128b7728d6b6
ARG TESSDATA_BEST_ENG_SHA256=8280aed0782fe27257a68ea10fe7ef324ca0f8d85bd2fd145d1c2b560bcb66ba
RUN if [ "$TESSDATA_BEST_ENABLED" = "1" ]; then set -e; \
      mkdir -p /opt/tessdata/best; \
      curl -sSLf -o /opt/tessdata/best/rus.traineddata "$TESSDATA_BEST_URL/rus.traineddata"; \
      curl -sSLf -o /opt/tessdata/best/eng.traineddata "$TESSDATA_BEST_URL/eng.traineddata"; \
      echo "$TESSDATA_BEST_RUS_SHA256  /opt/tessdata/best/rus.traineddata" | sha256sum -c -; \
      echo "$TESSDATA_BEST_ENG_SHA256  /opt/tessdata/best/eng.traineddata" | sha256sum -c -; \
      cp "$(dirname "$(find /usr/share -name osd.traineddata -print -quit)")/osd.traineddata" \
         /opt/tessdata/best/; \
    fi

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY core/ ./core/
COPY ingest/ ./ingest/
COPY alembic/ ./alembic/
COPY alembic.ini init_db.py ./

# Процесс работает не от root: исходники монтируются с хоста, и ошибка в
# коде не должна превращаться в право переписать рабочую копию. UID 1000
# совпадает с обычным пользователем Linux-хоста, поэтому смонтированные
# каталоги читаются без возни с правами.
RUN useradd --create-home --uid 1000 app \
    && mkdir -p /data/shared \
    && chown -R app:app /app /data/shared
USER app

CMD ["uvicorn", "ingest.api:app", "--host", "0.0.0.0", "--port", "8000"]
